# Copy to .env.local and fill in values.
DATABASE_URL="postgresql://postgres:dev@localhost:5432/wedding_dev?schema=public"

# HMAC secret for signing invite tokens. Rotate to invalidate every link at once.
INVITE_TOKEN_SECRET="change-me"

# Auth.js session secret.
AUTH_SECRET="change-me"

# --- Admin authentication (at least one method required) ---

# Simple password login — easiest for self-hosting.
# Set this to enable a password form on the admin sign-in page.
# ADMIN_PASSWORD="your-secure-password"

# OIDC single sign-on (Authelia, Keycloak, Dex, Google, GitHub, etc.)
# All three vars must be set together to enable SSO login.
# OIDC_ISSUER="https://auth.example.com"
# OIDC_CLIENT_ID="wedding-admin"
# OIDC_CLIENT_SECRET="change-me"
