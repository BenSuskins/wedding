{
  "name": "wedding",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun node_modules/next/dist/bin/next dev",
    "build": "bun node_modules/next/dist/bin/next build",
    "start": "bun node_modules/next/dist/bin/next start",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "lint": "bun node_modules/eslint/bin/eslint.js .",
    "test": "node node_modules/vitest/vitest.mjs run --project unit",
    "test:watch": "node node_modules/vitest/vitest.mjs --project unit",
    "test:contract": "node node_modules/vitest/vitest.mjs run --project contract",
    "e2e": "node node_modules/@playwright/test/cli.js test",
    "db:generate": "bun node_modules/prisma/build/index.js generate",
    "db:migrate": "bun node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "bun node_modules/prisma/build/index.js migrate deploy",
    "postinstall": "bun node_modules/prisma/build/index.js generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "marked": "^18.1.2",
    "neverthrow": "^8.2.0",
    "next": "^15.1.0",
    "next-auth": "5.0.0-beta.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^11.14.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "prisma",
    "sharp"
  ]
}
